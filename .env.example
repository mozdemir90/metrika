# METRİKA Yapılandırması
PORT=8000
ENVIRONMENT=production

# GLPI API Yapılandırması
GLPI_URL=http://glpi.belgenet.local/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_TIMEOUT_SECONDS=15.0

# Qwen LLM API Yapılandırması (jiraClassification_prod projesi ile aynı TÜRKSAT PAAS servisi)
HAKEM_API_URL=https://token.ai.turksat.com.tr/v1/chat/completions
HAKEM_API_KEY=your_turksat_paas_token_here
HAKEM_API_MODEL=qwen35-122b-a10b-fp8
QWEN_TIMEOUT_SECONDS=60.0
ENABLE_QWEN_LLM=true
